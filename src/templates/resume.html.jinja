<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{{ resume.name }}'s Resume</title>
        <!-- Bootstrap CSS -->
        <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">
        <!-- Roboto Font -->
        <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap" rel="stylesheet">
        <!-- Font Awesome Icons -->
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
        <!-- Custom CSS -->
        <link rel="stylesheet" href="resume.css">
    </head>
    <body>
        <div class="container">
            <div class="row align-items-center">
                <!-- Title -->
                <div class="col-md-7">
                    <div class="profile-title text-center">
                        <h2>{{ resume.name }}</h2>
                        <h5>{{ resume.description }}</h5>
                    </div>
                </div>

                <!-- Personal Information -->
                <div class="col-md-5">
                    <div class="personal-info">
                        <!-- Insert personal information here -->
                    </div>
                </div>
            </div>

            <div class="row">
                <!-- Side Panel -->
                <div class="col-md-4 side-panel">
                    <!-- Languages -->
                    <div class="languages">
                        <h3>Languages</h3>
{% for language in resume.languages %}
                        <div class="mb-3">
                            <p class="progress-label">{{ language.name }}</p>
                            <div class="progress">
                                <div class="progress-bar" role="progressbar" style="width: {{ language.level }}%;" aria-valuenow="{{ language.level }}"
                                    aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
    {% if language.note %}
                            <p class="note">{{ language.note }}</p>
    {% endif %}
                        </div>
{% endfor %}
                    </div>

                    <hr>

                    <!-- Skills -->
                    <div class="skills">
                        <h3>Skills</h3>
{% for skill_category in resume.skill_categories %}
                        <div class="mb-3">
                            <p class="skill-label">{{ skill_category.name }}</p>
    {% for skill in skill_category.skills %}
                            <div class="skill-box">
                                <div class="skill-bar">
                                    <div class="skill-bar-inner" style="width: 100%;"></div>
                                    <div class="skill-bar-text">{{ skill }}</div>
                                </div>
                            </div>
    {% endfor %}
                        </div>
{% endfor %}
                    </div>

                    <hr>

                    <!-- Interests -->
                    <div class="interests">
                        <h3>Interests</h3>
                        <ul>
{% for interest in resume.interests %}
                            <li><i class="fas fa-{{ interest.icon }}"></i> {{ interest.name }}</li>
{% endfor %}
                        </ul>
                    </div>
                </div>

                <!-- Main Content -->
                <div class="col-md-8 main-panel">
                    <hr>

                    <!-- Profile -->
                    <div class="profile">
                        <h3>Profile</h3>
                        <p>{{ resume.profile }}</p>
                    </div>

                    <hr>

                    <!-- Education -->
                    <div class="education">
                        <h3>Education</h3>
{% for school in resume.education %}
                        <p>
                            <strong>{{ school.name }}</strong>
    {% if not school.end %}
                            ({{ school.begin }} - Now)
    {% elif school.begin == school.end %}
                            ({{ school.begin}})
    {% else %}
                            ({{ school.begin }} - {{ school.end }})
    {% endif %}
                            - {{ school.short_description }}
                        </p>
    {% if school.topics %}
                        <ul>
        {% for topic in school.topics %}
                            <li>{{ topic }}</li>
        {% endfor %}
                        </ul>
    {% endif %}
{% endfor %}
                    </div>

                    <hr>

                    <div class="certificates">
                        <h3>Certificates</h3>
{% for certificate in resume.certificates %}
                        <p>
                            <strong>{{ certificate.name }}</strong>
    {% if certificate.note %}
                            {{ certificate.note }}
    {% endif %}
                            ({{ certificate.year }})
                        </p>
{% endfor %}
                    </div>

                    <hr>

                    <!-- Experience -->
                    <div class="experience">
                        <h3>Experience</h3>
{% for experience in resume.experiences %}
                        <p>
                            <strong>{{ experience.name }}</strong>
    {% if not experience.end %}
                            ({{ experience.begin }} - Now)
    {% elif experience.begin == experience.end %}
                            ({{ experience.begin}})
    {% else %}
                            ({{ experience.begin }} - {{ experience.end }})
    {% endif %}
                            - {{ experience.where }}
                        </p>
                        <ul>
    {% for task in experience.tasks %}
        {% if task is string %}
                            <li>{{ task }}</li>
        {% else %}
                            <li><strong>{{ task.name }}:</strong></li>
                            <ul>
            {% for subtask in task.subtasks %}
                                <li>{{ subtask }}</li>
            {% endfor %}
                            </ul>
        {% endif %}
    {% endfor %}
                        </ul>
{% endfor %}
                    </div>

                    <hr>

                    <!-- Projects -->
                    <div class="projects">
                        <h3>Projects</h3>
{% for project in resume.projects %}
                        <p>
                            <strong>{{ project.name }}</strong>
    {%- if project.personal %}
                            (Personal project)
    {%- endif %}
    {%- if project.ongoing %}
                            (Ongoing)
    {%- endif -%}
                            <strong>:</strong>
                            {{ project.description }}
                            <em>(
    {%- for language in project.languages -%}
                                {{ language }}
        {%- if not loop.last -%}
                                ,
        {% endif %}
    {%- endfor -%}
                            )</em>
                        </p>
{% endfor %}
                    </div>

                    <hr>
                </div>
            </div>
        </div>

        <script>
            document.addEventListener('DOMContentLoaded', function() {
                var skillBoxes = document.querySelectorAll('.skill-box');

                skillBoxes.forEach(function(skillBox) {
                    var skillText = skillBox.querySelector('.skill-bar-text');
                    var skillTextWidth = skillText.offsetWidth;

                    skillBox.style.width = skillTextWidth + 'px';
                });
            });
        </script>
    
        <!-- Bootstrap JS and Popper.js -->
        <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.0.8/dist/umd/popper.min.js"></script>
        <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
    </body>
</html>
